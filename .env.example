```env
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password

# PostgreSQL Configuration
POSTGRES_DB=energia_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_LOCAL=postgres
POSTGRES_PORT_LOCAL=55432
POSTGRES_APP_USER=your_postgres_app_user
POSTGRES_APP_PASSWORD=your_postgres_app_password

# Spring Boot PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/energia_db
SPRING_DATASOURCE_USERNAME=your_postgres_user
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# MongoDB Configuration
MONGO_DATABASE=energia_analytics
MONGO_USERNAME=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGO_AUTH_SOURCE=admin
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_HOST_LOCAL=localhost
MONGO_PORT_LOCAL=27017
MONGO_APP_USER=your_mongo_app_user
MONGO_APP_PASSWORD=your_mongo_app_password

ETL_FILE_DIST_PATH=/path/to/DistBase.xlsx
ETL_FILE_DIST_CONTAINER_PATH=/app/DistBase.xlsx
ETL_FILE_PERDAS_PATH=/path/to/Perdas.xlsx
ETL_FILE_PERDAS_CONTAINER_PATH=/app/Perdas.xlsx
ETL_CNPJ=00000000000000

SPRING_DATA_MONGODB_URI=mongodb://your_mongo_app_user:your_mongo_app_password@localhost:27017/energia_analytics?authSource=admin

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600000

# Server Configuration
SERVER_PORT_JAVA=8181
SERVER_PORT_PYTHON=8000

# Flyway Configuration
FLYWAY_USER=your_postgres_user
FLYWAY_PASSWORD=your_postgres_password

# CORS
CORS_ORIGINS=http://localhost:3000

# Privacy & Reconciliation
PRIVACY_RECONCILIATION_ENABLED=true
PRIVACY_BACKUP_RETENTION_DAYS=90

# Logging
SPRING_JPA_SHOW_SQL=true

# Admin Tools
PGADMIN_DEFAULT_EMAIL=your_pgadmin_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
ME_CONFIG_BASICAUTH_USERNAME=your_mongo_express_user
ME_CONFIG_BASICAUTH_PASSWORD=your_mongo_express_password

ANEEL_PERDAS_PAGE_INDEX=2
ANEEL_PERDAS_EXPORT_MODE=underlying
ANEEL_PERDAS_MAX_ROWS=30000
ANEEL_PERDAS_TIMEOUT_MS=120000
ANEEL_PERDAS_RETENTION_YEARS=5
ANEEL_PERDAS_HEADLESS=true
ANEEL_PERDAS_REPORT_URL=https://portalrelatorios.aneel.gov.br/luznatarifa/perdasenergias#!

INTERNAL_LOG_API_KEY=your_internal_api_key
INTERNAL_LOG_URL=http://backend-java:8181/internal/jobs/aneel/logs

TZ=America/Sao_Paulo

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=your_email@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
EMERGENCY_MAIL_API_KEY=your_emergency_api_key

BACKUP_DIRECTORY=../../backups
```
